#version 450

layout(push_constant) uniform PC {
    float value;
    float anchorX;
    float anchorY;
    float charW;
    float charH;
    uint  numChars;
    uint  mode;     // 0 = time, 1 = integer
} pc;

layout(location = 0) in vec2 fragUV;
layout(location = 1) flat in uint charIndex;

layout(location = 0) out vec4 outColor;

