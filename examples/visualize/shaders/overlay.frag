// Decode the time value into individual character indices.
// Format: "NNN.NN ms" (9 characters, index 0..8)
// Glyph index = ASCII code - 32.
uint getTimeGlyphIndex(uint pos) {
    float t = clamp(pc.value, 0.0, 999.99);
    uint intPart  = uint(t);
    uint fracPart = uint(fract(t) * 100.0 + 0.5);

    // Digit layout: [H][T][U][.][d1][d2][ ][m][s]
    //                0  1  2  3   4   5  6  7  8
    if (pos == 0u) return 16u + intPart / 100u;           // '0'-'9'
    if (pos == 1u) return 16u + (intPart / 10u) % 10u;    // '0'-'9'
    if (pos == 2u) return 16u + intPart % 10u;            // '0'-'9'
    if (pos == 3u) return 14u;                            // '.'
    if (pos == 4u) return 16u + fracPart / 10u;           // '0'-'9'
    if (pos == 5u) return 16u + fracPart % 10u;           // '0'-'9'
    if (pos == 6u) return 0u;                             // ' '
    if (pos == 7u) return 77u;                            // 'm'
    if (pos == 8u) return 83u;                            // 's'
    return 0u;
}

// Decode an integer value into digit glyph indices.
// Glyph index = ASCII code - 32.
uint getIntGlyphIndex(uint pos) {
    uint val = uint(pc.value + 0.5);
    uint digitFromRight = pc.numChars - 1u - pos;
    if (digitFromRight == 0u) return 16u + val % 10u;
    if (digitFromRight == 1u) return 16u + (val / 10u) % 10u;
    return 16u + (val / 100u) % 10u;
}

void main() {
    uint glyphIdx = (pc.mode == 0u) ? getTimeGlyphIndex(charIndex)
                                    : getIntGlyphIndex(charIndex);
    uint glyph    = GLYPHS[glyphIdx];

    // Map UV to 5x5 grid cell
    float cellX = fragUV.x * 5.0;
    float cellY = fragUV.y * 5.0;
    int col = clamp(int(cellX), 0, 4);
    int row = clamp(int(cellY), 0, 4);

    // Intra-cell margins: shrink lit area to leave gaps between pixels
    float fracX = fract(cellX);
    float fracY = fract(cellY);
    float margin = 0.15;
    bool inPixel = fracX > margin && fracX < (1.0 - margin)
                && fracY > margin && fracY < (1.0 - margin);

    // Look up bit: row-major, MSB = top-left (column is mirrored)
    uint bitIdx = uint(row) * 5u + (4u - uint(col));
    bool lit = inPixel && (glyph & (1u << bitIdx)) != 0u;

    if (lit)
        outColor = vec4(1.0, 1.0, 1.0, 1.0);
    else
        outColor = vec4(0.0, 0.0, 0.0, 0.5); // semi-transparent background
}
